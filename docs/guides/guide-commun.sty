% Capture d'écran encadrée, numérotée et référencée par fig:<fichier>.
% \capture[largeur]{fichier}{légende}
\newcommand{\capture}[3][\linewidth]{%
  \begin{figure}[H]
    \centering
    \setlength{\fboxsep}{0pt}%
    \fcolorbox{cadre}{white}{\includegraphics[width=\dimexpr#1-2\fboxrule\relax,height=0.85\textheight,keepaspectratio]{images/#2}}
    \caption{#3}
    \label{fig:#2}
  \end{figure}}

% Chemin de navigation dans l'interface : \chemin{Administration > Gérer les thématiques}
\newcommand{\chemin}[1]{\textsf{\textbf{\color{moodle}#1}}}
% Bouton ou libellé d'interface
\newcommand{\bouton}[1]{\textsf{«~#1~»}}
% Statut affiché par le module
\newcommand{\statut}[1]{\textsf{\textbf{#1}}}

\newtcolorbox{astuce}{colback=moodle!5, colframe=moodle, fonttitle=\bfseries,
  title=À noter, boxrule=0.6pt, arc=2pt}
\newtcolorbox{attention}{colback=orange!6, colframe=orange!80!black, fonttitle=\bfseries,
  title=Attention, boxrule=0.6pt, arc=2pt}
% Procédure pas à pas : \begin{procedure}{Titre}{Qui}\begin{etapes}\item ...\end{etapes}\end{procedure}
\newtcolorbox{procedure}[2]{breakable, enhanced, colback=white, colframe=moodle, boxrule=0.8pt, arc=2pt,
  fonttitle=\bfseries\sffamily, title={#1}, after title={\hfill\normalfont\small\sffamily #2},
  left=6pt, right=6pt, top=4pt, bottom=4pt}
\newcommand{\numetape}[1]{{\setlength{\fboxsep}{1.5pt}\colorbox{moodle}{\makebox[1.1em]{\color{white}\small\bfseries\sffamily #1}}}}
\newenvironment{etapes}{\begin{enumerate}[label={\protect\numetape{\arabic*}}, leftmargin=2.2em, itemsep=5pt]}{\end{enumerate}}
% Résultat d'une procédure : ce qui se passe ensuite.
\newcommand{\ensuite}[1]{\par\smallskip{\small\sffamily\textbf{\color{moodle}Ensuite~:} #1}\par}

% Texte de courriel : \begin{courriel}{Sujet}...\end{courriel}
\newtcolorbox{courriel}[1]{colback=black!3, colframe=black!40, boxrule=0.4pt, arc=1pt,
  fonttitle=\small\sffamily, coltitle=black, colbacktitle=black!10, title={Sujet : #1},
  fontupper=\small\sffamily, left=6pt, right=6pt}
% Variable de courriel : \var{student} donne {{student}}
\newcommand{\var}[1]{\texttt{\{\{#1\}\}}}

% Page de titre : \pagedegarde{public visé}{image de couverture}
\newcommand{\pagedegarde}[2]{%
  \begin{titlepage}
    \centering
    \vspace*{3cm}
    {\Huge\bfseries ThesisManager\par}
    \vspace{0.6cm}
    {\LARGE \titreguide\par}
    \vspace{0.4cm}
    {\large #1\par}
    \vspace{1.5cm}
    \setlength{\fboxsep}{0pt}
    \fcolorbox{cadre}{white}{\includegraphics[width=0.85\linewidth,height=0.42\textheight,keepaspectratio]{images/#2}}
    \vfill
    {\large Sébastien Lefebvre\par}
    \vspace{0.3cm}
    {\large Version \versionguide{} -- \dateguide\par}
    {\small Module couvert : \texttt{mod\_these} \versionthese\par}
  \end{titlepage}}

