{{!
    @template mod_these/signed_documents

    Documents signés d'un dossier et état des signatures. Les documents que l'utilisateur ne peut pas
    voir sont retirés par \mod_these\output\signed_documents::export_for_template().

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hasdocuments Au moins un document est disponible.
    * warning Alerte pour la DEVE (modèle de contrat à revoir), ou false.
    * heading Titre.
    * table Contexte de mod_these/table.

    Example context (json):
    {
        "hasdocuments": true,
        "warning": false,
        "heading": "Documents signés",
        "table": {"tableclass": "generaltable these-signatures", "hashead": true,
            "head": [{"text": "Document", "class": "header c0", "isth": true}, {"text": "Signatures", "class": "header c1 lastcol", "isth": true}],
            "rows": [{"class": "lastrow", "cells": [
                {"class": "cell c0", "parts": [{"ptext": {"value": "Dépôt du sujet"}, "phtml": false,
                    "pstrong": false, "pstronghtml": false, "pem": false, "pbadge": false, "pspan": false,
                    "plink": false, "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false, "pdetails": false}]},
                {"class": "cell c1 lastcol", "parts": [{"ptext": {"value": "Télécharger le PDF"}, "phtml": false,
                    "pstrong": false, "pstronghtml": false, "pem": false, "pbadge": false, "pspan": false,
                    "plink": false, "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false, "pdetails": false}]}
            ]}]
        }
    }
}}
{{#hasdocuments}}
<h4 class="mt-4">{{heading}}</h4>
{{#table}}{{> mod_these/table}}{{/table}}
{{#warning}}
<div class="alert alert-warning">{{warning}}</div>
{{/warning}}
{{/hasdocuments}}
