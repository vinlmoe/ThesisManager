{{!
    @template mod_these/embargo

    Diffusion de la thèse et demande d'embargo, en section de détail. Le motif de l'embargo n'est
    présent dans le contexte que pour qui connaît le sujet.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hasrows, heading, table Voir mod_these/detail_section.

    Example context (json):
    {
        "hasrows": true,
        "heading": "Diffusion",
        "table": {"tableclass": "generaltable these-detail", "hashead": false, "head": [], "rows": [
            {"class": "lastrow", "cells": [
                {"class": "cell c0", "parts": [{"ptext": false, "phtml": false, "pstrong": {"value": "Embargo"},
                    "pstronghtml": false, "pem": false, "pbadge": false, "pspan": false, "plink": false,
                    "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false}]},
                {"class": "cell c1 lastcol", "parts": [{"ptext": false, "phtml": false, "pstrong": false,
                    "pstronghtml": false, "pem": false,
                    "pbadge": {"value": "Demandé pour 5 ans, jusqu'au 3 décembre 2031", "class": "badge badge-warning"},
                    "pspan": false, "plink": false, "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false}]}
            ]}
        ]}
    }
}}
{{> mod_these/detail_section}}
