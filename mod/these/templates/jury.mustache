{{!
    @template mod_these/jury

    Tableau du jury d'un dossier. Les colonnes affichées (adresse, éligibilité) sont choisies par
    \mod_these\output\jury::export_for_template() selon les droits de l'utilisateur.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hasmembers Le jury a au moins un membre.
    * heading Titre.
    * table Contexte de mod_these/table.

    Example context (json):
    {
        "hasmembers": true,
        "heading": "Jury",
        "table": {"tableclass": "generaltable", "hashead": true,
            "head": [{"text": "Rôle", "class": "header c0", "isth": true}, {"text": "Nom", "class": "header c1 lastcol", "isth": true}],
            "rows": [{"class": "lastrow", "cells": [
                {"class": "cell c0", "parts": [{"ptext": {"value": "Président"}, "phtml": false, "pstrong": false,
                    "pstronghtml": false, "pem": false, "pbadge": false, "pspan": false, "plink": false,
                    "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false, "pdetails": false, "pcode": false, "pcheckbox": false}]},
                {"class": "cell c1 lastcol", "parts": [{"ptext": {"value": "Paul Président"}, "phtml": false,
                    "pstrong": false, "pstronghtml": false, "pem": false, "pbadge": false, "pspan": false,
                    "plink": false, "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false, "pdetails": false, "pcode": false, "pcheckbox": false}]}
            ]}]
        }
    }
}}
{{#hasmembers}}
<h4 class="mt-4">{{heading}}</h4>
{{#table}}{{> mod_these/table}}{{/table}}
{{/hasmembers}}
