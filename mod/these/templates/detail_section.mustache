{{!
    @template mod_these/detail_section

    Section de détail d'un dossier : titre et tableau libellé / valeur. Rien n'est rendu sans ligne.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hasrows La section a au moins une ligne.
    * heading Titre de la section.
    * table Contexte de mod_these/table.

    Example context (json):
    {
        "hasrows": true,
        "heading": "Enregistrements",
        "table": {"tableclass": "generaltable these-detail", "hashead": false, "head": [], "rows": [
            {"class": "lastrow", "cells": [
                {"class": "cell c0", "parts": [{"ptext": false, "phtml": false, "pstrong": {"value": "Numéro DEVE"},
                    "pstronghtml": false, "pem": false, "pbadge": false, "pspan": false, "plink": false,
                    "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false, "pdetails": false}]},
                {"class": "cell c1 lastcol", "parts": [{"ptext": {"value": "2026-042"}, "phtml": false,
                    "pstrong": false, "pstronghtml": false, "pem": false, "pbadge": false, "pspan": false,
                    "plink": false, "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false, "pdetails": false}]}
            ]}
        ]}
    }
}}
{{#hasrows}}
<h4 class="mt-4">{{heading}}</h4>
{{#table}}{{> mod_these/table}}{{/table}}
{{/hasrows}}
