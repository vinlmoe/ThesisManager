{{!
    @template mod_these/saved_signature

    Signature enregistrée de l'utilisateur (image PNG en data URI) et bouton de suppression, ou
    mention de son absence.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hassignature L'utilisateur a une signature enregistrée.
    * src, alt Image.
    * deleteurl, deletelabel Bouton de suppression.
    * nonelabel Mention sans signature.

    Example context (json):
    {"hassignature": true, "src": "data:image/png;base64,iVBORw0KGgo=", "alt": "Signature enregistrée",
        "deleteurl": "https://example.com/mod/these/mysignatures.php?deletesaved=1", "deletelabel": "Supprimer",
        "nonelabel": "Aucune signature enregistrée"}
}}
{{#hassignature}}
<div class="mb-2"><img src="{{src}}" alt="{{alt}}" class="border" style="max-height:100px;background:#fff;" /></div><a href="{{deleteurl}}" class="btn btn-secondary">{{deletelabel}}</a>
{{/hassignature}}
{{^hassignature}}
<div class="text-muted">{{nonelabel}}</div>
{{/hassignature}}
