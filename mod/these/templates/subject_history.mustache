{{!
    @template mod_these/subject_history

    Anciens sujets d'un dossier, montrés seulement à qui connaît le sujet (choix fait par
    \mod_these\output\dossier::export_for_template()).

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hasentries Le dossier a changé de sujet au moins une fois.
    * heading Titre.
    * table Contexte de mod_these/table.

    Example context (json):
    {
        "hasentries": true,
        "heading": "Historique du sujet",
        "table": {"tableclass": "generaltable these-subjecthistory", "hashead": true,
            "head": [{"text": "Date", "class": "header c0", "isth": true}, {"text": "Titre", "class": "header c1 lastcol", "isth": true}],
            "rows": [{"class": "lastrow", "cells": [
                {"class": "cell c0", "parts": [{"ptext": {"value": "1/01/26, 10:00"}, "phtml": false,
                    "pstrong": false, "pstronghtml": false, "pem": false, "pbadge": false, "pspan": false,
                    "plink": false, "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false, "pdetails": false, "pcode": false, "pcheckbox": false}]},
                {"class": "cell c1 lastcol", "parts": [{"ptext": {"value": "Ancien sujet"}, "phtml": false,
                    "pstrong": false, "pstronghtml": false, "pem": false, "pbadge": false, "pspan": false,
                    "plink": false, "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false, "pdetails": false, "pcode": false, "pcheckbox": false}]}
            ]}]
        }
    }
}}
{{#hasentries}}
<h4 class="mt-4">{{heading}}</h4>
{{#table}}{{> mod_these/table}}{{/table}}
{{/hasentries}}
