{{!
    @template mod_these/dossier_table

    Tableau de dossiers du tableau de bord. Le titre d'une thèse confidentielle est déjà remplacé par
    la mention « Thèse confidentielle » pour qui ne connaît pas le sujet.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * isempty Aucun dossier.
    * emptymessage Message affiché sans dossier.
    * table Contexte de mod_these/table.

    Example context (json):
    {
        "isempty": false,
        "emptymessage": "",
        "table": {"tableclass": "generaltable these-dossiers", "hashead": true,
            "head": [{"text": "Étudiant", "class": "header c0", "isth": true}, {"text": "Titre", "class": "header c1 lastcol", "isth": true}],
            "rows": [{"class": "lastrow", "cells": [
                {"class": "cell c0", "parts": [{"ptext": {"value": "Anne Martin"}, "phtml": false,
                    "pstrong": false, "pstronghtml": false, "pem": false, "pbadge": false, "pspan": false,
                    "plink": false, "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false, "pdetails": false}]},
                {"class": "cell c1 lastcol", "parts": [{"ptext": false, "phtml": false, "pstrong": false,
                    "pstronghtml": false, "pem": {"value": "Thèse confidentielle"}, "pbadge": false, "pspan": false,
                    "plink": false, "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false, "pdetails": false}]}
            ]}]
        }
    }
}}
{{#isempty}}
<div class="alert alert-info">{{emptymessage}}</div>
{{/isempty}}
{{^isempty}}
{{#table}}{{> mod_these/table}}{{/table}}
{{/isempty}}
