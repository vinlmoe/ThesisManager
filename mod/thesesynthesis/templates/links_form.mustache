{{!
    @template mod_thesesynthesis/links_form

    Formulaire des promotions suivies : une case à cocher par activité proposée.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * action Adresse du formulaire.
    * sesskey Clé de session.
    * table Contexte de mod_these/table.
    * savelabel Libellé du bouton.

    Example context (json):
    {"action": "https://example.com/mod/thesesynthesis/administration.php?id=2", "sesskey": "abc",
        "table": {"tableclass": "generaltable", "hashead": true,
            "head": [{"text": "Cours", "class": "header c0 lastcol", "isth": true}],
            "rows": [{"class": "lastrow", "cells": [{"class": "cell c0 lastcol", "parts": [{"ptext": {"value": "Promo 2026"}, "phtml": false, "pstrong": false, "pstronghtml": false, "pem": false, "pbadge": false, "pspan": false, "plink": false, "pmuted": false, "pbr": false, "pfiles": false, "pstatus": false, "pdetails": false, "pcode": false, "pcheckbox": false}]}]}]},
        "savelabel": "Enregistrer"}
}}
<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}" /><input type="hidden" name="save" value="1" />{{#table}}{{> mod_these/table}}{{/table}}<button type="submit" class="btn btn-primary">{{savelabel}}</button></form>
